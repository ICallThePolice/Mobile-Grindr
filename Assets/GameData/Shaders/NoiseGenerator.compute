#pragma kernel CSMain

struct BiomeData
{
    float baseHeight;
    int biomeType;
};

struct VoxelData
{
    float density;
    float3 biomeWeights;
};

StructuredBuffer<BiomeData> _BiomeData;
RWStructuredBuffer<VoxelData> voxelBuffer;

int3 chunkPosition;
int3 chunkSize;
int numBiomes;

float _Amplitude;
float _Frequency;
float _SurfaceLevel;
float _BiomeMapScale;

#define NUM_OCTAVES 3 
float _Lacunarity;
float _Persistence;

// --- Simplex Noise ---
float3 mod289(float3 x)
{
    return x - floor(x * (1.0 / 289.0)) * 289.0;
}
float4 mod289(float4 x)
{
    return x - floor(x * (1.0 / 289.0)) * 289.0;
}
float4 permute(float4 x)
{
    return mod289(((x * 34.0) + 1.0) * x);
}
float4 taylorInvSqrt(float4 r)
{
    return 1.79284291400159 - 0.85373472095314 * r;
}

float snoise(float3 v)
{
    const float2 C = float2(1.0 / 6.0, 1.0 / 3.0);
    const float4 D = float4(0.0, 0.5, 1.0, 2.0);
    float3 i = floor(v + dot(v, C.yyy));
    float3 x0 = v - i + dot(i, C.xxx);
    float3 g = step(x0.yzx, x0.xyz);
    float3 l = 1.0 - g;
    float3 i1 = min(g.xyz, l.zxy);
    float3 i2 = max(g.xyz, l.zxy);
    float3 x1 = x0 - i1 + C.xxx;
    float3 x2 = x0 - i2 + C.yyy;
    float3 x3 = x0 - D.yyy;
    i = mod289(i);
    float4 p = permute(permute(permute(i.z + float4(0.0, i1.z, i2.z, 1.0)) + i.y + float4(0.0, i1.y, i2.y, 1.0)) + i.x + float4(0.0, i1.x, i2.x, 1.0));
    float n_ = 0.142857142857;
    float3 ns = n_ * D.wyz - D.xzx;
    float4 j = p - 49.0 * floor(p * ns.z * ns.z);
    float4 x_ = floor(j * ns.z);
    float4 y_ = floor(j - 7.0 * x_);
    float4 x = x_ * ns.x + ns.yyyy;
    float4 y = y_ * ns.x + ns.yyyy;
    float4 h = 1.0 - abs(x) - abs(y);
    float4 b0 = float4(x.xy, y.xy);
    float4 b1 = float4(x.zw, y.zw);
    float4 s0 = floor(b0) * 2.0 + 1.0;
    float4 s1 = floor(b1) * 2.0 + 1.0;
    float4 sh = -step(h, 0.0);
    float4 a0 = b0.xzyw + s0.xzyw * sh.xxyy;
    float4 a1 = b1.xzyw + s1.xzyw * sh.zzww;
    float3 p0 = float3(a0.xy, h.x);
    float3 p1 = float3(a0.zw, h.y);
    float3 p2 = float3(a1.xy, h.z);
    float3 p3 = float3(a1.zw, h.w);
    float4 norm = taylorInvSqrt(float4(dot(p0, p0), dot(p1, p1), dot(p2, p2), dot(p3, p3)));
    p0 *= norm.x;
    p1 *= norm.y;
    p2 *= norm.z;
    p3 *= norm.w;
    float4 m = max(0.6 - float4(dot(x0, x0), dot(x1, x1), dot(x2, x2), dot(x3, x3)), 0.0);
    m = m * m;
    return 42.0 * dot(m * m, float4(dot(p0, x0), dot(p1, x1), dot(p2, x2), dot(p3, x3)));
}

float fractalNoise(float3 pos)
{
    float total = 0.0;
    float frequency = _Frequency;
    float amplitude = _Amplitude;
    float maxValue = 0.0;
    for (int i = 0; i < NUM_OCTAVES; i++)
    {
        total += snoise(pos * frequency) * amplitude;
        maxValue += amplitude;
        amplitude *= _Persistence;
        frequency *= _Lacunarity;
    }
    if (maxValue == 0.0)
        return 0.0;
    return total / maxValue;
}

float2 hash22(float2 p)
{
    p = float2(dot(p, float2(127.1, 311.7)), dot(p, float2(269.5, 183.3)));
    return -1.0 + 2.0 * frac(sin(p) * 43758.5453123);
}

void getBiomeData(float2 pos, out uint id1, out float dist1, out uint id2, out float dist2)
{
    float2 grid_pos = floor(pos);
    float2 frac_pos = frac(pos);
    dist1 = 100.0;
    dist2 = 100.0;
    id1 = 0;
    id2 = 0;

    for (int y = -2; y <= 2; y++)
    {
        for (int x = -2; x <= 2; x++)
        {
            float2 neighbor_cell = float2(x, y);
            float2 cell_pos = grid_pos + neighbor_cell;
            float2 random_point_offset = hash22(cell_pos);
            float d = distance(frac_pos, neighbor_cell + random_point_offset);
            
            uint currentID = 0;
            if (numBiomes > 0)
                currentID = (uint) (abs(cell_pos.x * 15485863.0 + cell_pos.y * 32452843.0)) % (uint) numBiomes;

            if (d < dist1)
            {
                if (currentID != id1)
                {
                    dist2 = dist1;
                    id2 = id1;
                }
                dist1 = d;
                id1 = currentID;
            }
            else if (d < dist2 && currentID != id1)
            {
                dist2 = d;
                id2 = currentID;
            }
        }
    }
}

float GetBiomeDensity(BiomeData biome, float3 worldPos)
{
    float density = biome.baseHeight - worldPos.y;
    
    if (biome.biomeType == 0)
    { // Vital
        float hills = fractalNoise(worldPos) * _Amplitude;
        float riverNoise = abs(snoise(float3(worldPos.x * 0.015, 0.0, worldPos.z * 0.015)));
        float rivers = smoothstep(0.0, 0.08, 0.08 - riverNoise) * 20.0;
        density += hills - rivers;
    }
    else if (biome.biomeType == 1)
    { // Ereb
        float wasteland = fractalNoise(worldPos * 1.5) * (_Amplitude * 0.5);
        float craterNoise = snoise(float3(worldPos.x * 0.03, 0.0, worldPos.z * 0.03));
        float craters = smoothstep(0.5, 0.8, craterNoise) * 25.0;
        float islands = 0.0;
        if (worldPos.y > biome.baseHeight + 15.0 && worldPos.y < biome.baseHeight + 45.0)
        {
            float islandNoise = snoise(worldPos * 0.05);
            islands = smoothstep(0.6, 0.8, islandNoise) * 25.0;
        }
        density += wasteland - craters + islands;
    }
    else if (biome.biomeType == 2)
    { // Psy
        float ridges = 0.0;
        float freq = _Frequency * 0.8;
        float amp = _Amplitude;
        for (int i = 0; i < 3; i++)
        {
            ridges += (1.0 - abs(snoise(worldPos * freq))) * amp;
            freq *= 2.0;
            amp *= 0.5;
        }
        float plateauHeight = biome.baseHeight + 15.0;
        float flatten = smoothstep(plateauHeight - 10.0, plateauHeight + 2.0, worldPos.y);
        ridges = lerp(ridges, 0.0, flatten);
        density += ridges;
    }
    return density;
}

[numthreads(8, 8, 8)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    int index = id.x + id.y * chunkSize.x + id.z * (chunkSize.x * chunkSize.y);
    int totalVoxels = chunkSize.x * chunkSize.y * chunkSize.z;
    if (index >= totalVoxels)
        return;

    float3 worldPos = float3(id) + float3(chunkPosition * (chunkSize - 1));
    
    uint id1 = 0, id2 = 0;
    float dist1 = 0.0, dist2 = 0.0;
    getBiomeData(worldPos.xz * _BiomeMapScale, id1, dist1, id2, dist2);
    
    // Вычисляем веса для смешивания (Inverse Distance Weighting)
    float w1 = 1.0 / (pow(dist1, 4.0) + 0.0001);
    float w2 = 1.0 / (pow(dist2, 4.0) + 0.0001);
    float totalW = w1 + w2;
    w1 /= totalW;
    w2 /= totalW;

    float den1 = GetBiomeDensity(_BiomeData[id1], worldPos);
    float den2 = GetBiomeDensity(_BiomeData[id2], worldPos);
    
    float finalDensity = den1 * w1 + den2 * w2;
    if (worldPos.y <= 4.0)
        finalDensity = max(finalDensity, 5.0 - worldPos.y);

    // Записываем ВЕСА биомов в RGB каналы (R=Vital, G=Ereb, B=Psy)
    float3 weights = float3(0, 0, 0);
    int type1 = _BiomeData[id1].biomeType;
    int type2 = _BiomeData[id2].biomeType;

    if (type1 == 0)
        weights.r += w1;
    else if (type1 == 1)
        weights.g += w1;
    else if (type1 == 2)
        weights.b += w1;

    if (type2 == 0)
        weights.r += w2;
    else if (type2 == 1)
        weights.g += w2;
    else if (type2 == 2)
        weights.b += w2;
    
    voxelBuffer[index].density = finalDensity;
    voxelBuffer[index].biomeWeights = weights;
}